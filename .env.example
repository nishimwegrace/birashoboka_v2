APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8000

# Database (use 'db' when running with Docker)
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=birashoboka_v2
DB_USERNAME=root
DB_PASSWORD=rootsecret

APP_KEY=change_me_to_a_random_string
TOKEN_EXPIRE_DAYS=30

IMAGE_MAX_WIDTH=1600
IMAGE_MAX_HEIGHT=1600
IMAGE_QUALITY=82

CORS_ALLOWED_ORIGINS=*
